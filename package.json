{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern work",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/cineradar.test.mjs tests/benchmark.test.mjs tests/temporal-observations.test.mjs tests/review-workflow.test.mjs tests/coverage-pipeline.test.mjs tests/decision-fields.test.mjs tests/review-triage.test.mjs tests/auto-review.test.mjs tests/directory-harvest.test.mjs tests/weekly-brief.test.mjs tests/deadline-hunt.test.mjs tests/series-extraction.test.mjs tests/platform-connectors.test.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:generate": "drizzle-kit generate",
    "radar:discover": "node scripts/cineradar/discover.mjs",
    "radar:monitor": "node scripts/cineradar/monitor.mjs",
    "radar:revalidate": "node scripts/cineradar/revalidate-urls.mjs",
    "radar:stale": "node scripts/cineradar/stale-check.mjs",
    "radar:seed-sources": "node scripts/cineradar/seed-sources.mjs",
    "radar:audit": "node scripts/cineradar/audit-opportunities.mjs",
    "radar:cost-report": "node scripts/cineradar/cost-report.mjs",
    "radar:backfill-integrity": "node scripts/cineradar/backfill-integrity.mjs",
    "radar:benchmark": "node scripts/cineradar/benchmark.mjs",
    "radar:history": "node scripts/cineradar/history-backfill.mjs",
    "radar:import-registry": "node scripts/cineradar/import-registry.mjs",
    "radar:coverage": "node scripts/cineradar/coverage.mjs",
    "radar:resolve-sites": "node scripts/cineradar/resolve-sites.mjs",
    "radar:triage": "node scripts/cineradar/triage.mjs",
    "radar:auto-review": "node scripts/cineradar/auto-review.mjs",
    "radar:enrich-existing": "node scripts/cineradar/enrich-existing.mjs",
    "radar:harvest": "node scripts/cineradar/harvest-directories.mjs",
    "radar:brief": "node scripts/cineradar/weekly-brief.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fflate": "0.7.4",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
