# Public web configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase access. Never use a NEXT_PUBLIC_ prefix for this value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only exact email allowlist for /team. If unset, access is denied.
CINERADAR_TEAM_EMAILS=reviewer@your-domain.example

# Discovery
EXA_API_KEY=your-exa-api-key

# Preferred extraction provider
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast

# Optional extraction provider. Disabled by default to prevent double billing
# after a Cloudflare request may already have consumed inference.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_ENABLED=false

# Optional protected ingestion endpoint. Direct scheduled ingestion uses Supabase.
INGEST_SECRET=replace-with-a-strong-random-value
CINERADAR_INGEST_URL=

# Cost and request guardrails
DISCOVERY_QUERY_LIMIT=4
DISCOVERY_RESULT_LIMIT=5
MAX_LLM_CALLS_PER_RUN=24
FREE_PROCESSING_LIMIT=40
HTTP_TIMEOUT_MS=12000
LLM_TIMEOUT_MS=45000
MONITOR_LINK_LIMIT=2
LLM_CONCURRENCY=2
URL_VALIDATION_CONCURRENCY=4
SOURCE_REFRESH_LIMIT=40
REVALIDATION_LIMIT=200
STALE_CHECK_LIMIT=1000

# Hard acquisition budget. Values above 10 are clamped to EUR 10.
MONTHLY_TARGET_EUR=3
OPTIONAL_STOP_EUR=4
MONTHLY_BUDGET_EUR=5
# Conservative configurable conversion used by the budget ledger (minimum 1).
USD_TO_EUR_RATE=1
# Stay below the Cloudflare Workers AI free daily allocation.
CLOUDFLARE_DAILY_NEURON_LIMIT=9000
HISTORICAL_PAGE_LIMIT=10
